# syntax=docker/dockerfile:1
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS build
RUN apk add --no-cache openssl libc6-compat && corepack enable
WORKDIR /app
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
COPY . .
RUN --mount=type=cache,id=toolkit-pnpm,target=/pnpm/store pnpm install --frozen-lockfile --store-dir=/pnpm/store
RUN pnpm --filter @repo/api build

# Preserve installed workspace metadata before pnpm deploy prepares its own store.
FROM build AS migrate
CMD ["pnpm", "--filter", "@repo/db", "db:migrate"]

FROM build AS package
RUN cp -R node_modules/.pnpm/@prisma+client*/node_modules/.prisma/client /generated-client
RUN pnpm --filter @repo/api deploy --prod --legacy /out
# Replace the deploy-time placeholder at the nearest Node resolution location.
RUN for target in /out/node_modules/.pnpm/@prisma+client*/node_modules/.prisma/client; do cp -R /generated-client/. "$target/"; done
RUN cd /out && DATABASE_URL=file:/tmp/image-smoke.db node --input-type=module -e 'import { prisma } from "@repo/db"; await prisma.$queryRawUnsafe("SELECT 1"); await prisma.$disconnect(); console.log("Generated Prisma runtime verified");'

FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS runtime
RUN apk add --no-cache openssl libc6-compat && mkdir /data && chown node:node /data
WORKDIR /app
ENV NODE_ENV=production PORT=3001
COPY --from=package --chown=node:node /out ./
USER node
EXPOSE 3001
HEALTHCHECK --interval=20s --timeout=5s --start-period=30s --retries=5 CMD node -e "fetch('http://127.0.0.1:3001/api/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/server.js"]

