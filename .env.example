NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/shop
REDIS_URL=redis://127.0.0.1:6379
APP_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:3001
